# commotiai-forex — environment template
# Copy to .env and fill in real values. Never commit .env.
# All keys below are OPTIONAL at bootstrap (Wave 0). Wave 1+ will require the ones marked [required].

# ── Telegram [required for alerts] ─────────────────────────────
# Bot token from @BotFather
TELEGRAM_TOKEN=

# Chat IDs (multiple channels supported)
TELEGRAM_CHAT_ID=
ALL_CHAT_ID=
NASDAQ_CHAT_ID=

# ── MetaTrader 5 bridge [required for live trading] ────────────
# Path to MT5 Common\Files directory on Windows.
# Example: C:\Users\<you>\AppData\Roaming\MetaQuotes\Terminal\Common\Files
# On Linux/CI this is unused.
MT5_FILES=

# ── WhatsApp via CallMeBot [optional] ──────────────────────────
# Setup: send "I allow callmebot to send me messages" to +34 644 65 21 91
# You'll receive an API key in WhatsApp. Store here.
WHATSAPP_PHONE=
WHATSAPP_APIKEY=

# ── Anthropic Claude API [optional, for AI-assisted analysis] ──
ANTHROPIC_API_KEY=

# ── Risk policy overrides [optional — sensible defaults in risk_policy.py] ─
# MAX_DAILY_DRAWDOWN_PCT=3.8
# NEWS_BLOCK_HOURS=2
# MIN_BIAS_CONFIDENCE=0.4
# FOCUS_CONFIDENCE_THRESHOLD=0.6

# ── Data providers (all free tier, no key required by default) ─
# yfinance uses no key.
# Add a paid feed here if you migrate one:
# ALPHAVANTAGE_KEY=
# POLYGON_KEY=
