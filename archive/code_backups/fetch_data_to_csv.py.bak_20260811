import os
import logging
from datetime import datetime, timedelta, timezone

import pandas as pd
import requests

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s - %(levelname)s - %(message)s"
)

API_KEY = os.getenv("TWELVEDATA_API_KEY")
BASE_URL = "https://api.twelvedata.com/time_series"

SYMBOLS = [
    "EUR/USD",
    "USD/CHF",
    "NZD/USD",
    "GBP/USD",
    "USD/JPY",
]

OUTPUT_SIZE_1H = 5  # מספר ברים שעתי למשיכה


def parse_bar_datetime(dt_str: str) -> datetime:
    dt = pd.to_datetime(dt_str, utc=True)
    if isinstance(dt, pd.Timestamp):
        return dt.to_pydatetime()
    raise ValueError(f"Invalid datetime value: {dt_str}")


def get_last_closed_bar(values: list, now_utc: datetime, interval_hours: int = 1) -> dict | None:
    """
    מחזיר את הבר האחרון שסגור לחלוטין.
    """
    for bar in values:
        bar_time = parse_bar_datetime(bar["datetime"])
        if bar_time + timedelta(hours=interval_hours) <= now_utc:
            return bar
    return None


def fetch_1h() -> pd.DataFrame:
    """
    מושך את בר ה-1H האחרון לכל זוג.
    """
    if not API_KEY:
        raise RuntimeError("TWELVEDATA_API_KEY is not set")

    now_utc = datetime.now(timezone.utc)

    params = {
        "symbol": ",".join(SYMBOLS),
        "interval": "1h",
        "outputsize": OUTPUT_SIZE_1H,
        "order": "desc",
        "timezone": "UTC",
        "format": "JSON",
        "apikey": API_KEY,
    }

    logging.info(f"Requesting interval=1h, outputsize={OUTPUT_SIZE_1H}")
    response = requests.get(BASE_URL, params=params, timeout=30)
    response.raise_for_status()
    data = response.json()

    results = []

    for symbol in SYMBOLS:
        symbol_data = data.get(symbol)

        if not symbol_data:
            logging.warning(f"1h {symbol} -> No response object")
            continue

        if symbol_data.get("status") == "error":
            logging.warning(f"1h {symbol} -> API error: {symbol_data.get('message')}")
            continue

        values = symbol_data.get("values")
        if not values:
            logging.warning(f"1h {symbol} -> No values returned")
            continue

        closed_bar = get_last_closed_bar(values, now_utc, interval_hours=1)
        if not closed_bar:
            logging.warning(f"1h {symbol} -> No closed 1h bar found")
            continue

        open_price = float(closed_bar["open"])
        close_price = float(closed_bar["close"])
        ret = (close_price - open_price) / open_price

        results.append({
            "symbol": symbol.replace("/", ""),
            "pair": symbol,
            "timestamp": closed_bar["datetime"],
            "open": open_price,
            "close": close_price,
            "change": ret,
        })

        logging.info(
            f"1h {symbol} -> timestamp={closed_bar['datetime']} "
            f"open={open_price} close={close_price} change={ret:.6f}"
        )

    df = pd.DataFrame(results)

    if not df.empty:
        df["timestamp"] = pd.to_datetime(df["timestamp"], utc=True)
        df = df.sort_values(["timestamp", "pair"]).reset_index(drop=True)
        df["timestamp"] = df["timestamp"].dt.strftime("%Y-%m-%d %H:%M:%S")

    return df


def main():
    df_1h = fetch_1h()
    if df_1h.empty:
        logging.warning("1H: No rows fetched. pair_changes_1h.csv was not updated.")
    else:
        df_1h.to_csv("pair_changes_1h.csv", index=False)
        logging.info(f"Saved pair_changes_1h.csv with {len(df_1h)} rows")


if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        print(f"\nERROR: {e}")
    input("\nPress Enter to exit...")